{
  "name": "@nearpay-money/x402",
  "version": "0.3.0",
  "description": "NearPay x402: paywall middleware for Express, Hono and fetch handlers (Next.js), and an agent fetch client that pays with NEAR Intents (intents-transfer) or cross-chain (near-intents).",
  "keywords": [
    "nearpay",
    "x402",
    "http-402",
    "paywall",
    "agents",
    "near-intents",
    "express",
    "hono",
    "payments",
    "crypto"
  ],
  "homepage": "https://docs.nearpay.money",
  "bugs": {
    "url": "https://github.com/nearpay-money/nearpay-agentkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearpay-money/nearpay-agentkit.git",
    "directory": "packages/x402"
  },
  "license": "Apache-2.0",
  "author": "NearPay <nearpaydotmoney@gmail.com> (https://nearpay.money)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@nearpay-money/agent-signer": "workspace:*",
    "@nearpay-money/spec": "0.5.0"
  },
  "peerDependencies": {
    "hono": "^4.6.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
