{
  "name": "nearpay-agentkit",
  "private": true,
  "version": "0.2.0",
  "description": "NearPay agent payments toolkit: @nearpay/x402 (paywall middleware + agent client, incl. cross-chain near-intents), @nearpay/agent-signer (NEAR Intents signing) and @nearpay/mcp (MCP server for agents).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "verify": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm build",
    "release:local": "node scripts/release-local.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nearpay-internal/intents": "0.3.0",
    "@nearpay/spec": "0.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "bs58": "6.0.0",
    "canonicalize": "5.1.0",
    "express": "5.3.0",
    "fast-check": "4.10.2",
    "hono": "4.13.13",
    "typescript": "5.9.3",
    "viem": "2.57.7",
    "vitest": "2.1.9",
    "zod": "4.6.7"
  },
  "pnpm": {
    "overrides": {
      "@nearpay/spec": "0.3.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
